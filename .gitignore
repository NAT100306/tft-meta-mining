# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches
.ipynb_checkpoints/
.pytest_cache/

# Large datasets (>100MB violates GitHub limits)
data/raw/*.csv
data/raw/*.json
data/processed/
data/kaggle_raw/

# Office temp lock files
~$*

# OS files
.DS_Store
Thumbs.db

# Logs & test execution results
*.log
*execution_results.json
RUN_NOTES.txt
